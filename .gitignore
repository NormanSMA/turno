# TURNO -- reglas de versionado
#
# Regla central: si un comando lo genera, no se versiona.
# Se versiona lo que ninguna herramienta puede volver a producir.

# --- Dependencias -----------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Compilacion ------------------------------------------------------------
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts
/src/generated

# --- Pruebas y cobertura ----------------------------------------------------
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.stryker-tmp/

# --- Entorno y secretos -----------------------------------------------------
# Las variables reales nunca se suben. El ejemplo si.
.env
.env.*
!.env.example
*.pem
*.key

# --- Despliegue -------------------------------------------------------------
.vercel

# --- Registros --------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Editor y sistema operativo ---------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- Herramientas de asistencia ---------------------------------------------
# Solo se versiona la configuracion compartida del servidor de vista previa.
.claude/*
!.claude/launch.json
graphify-out/

# --- Archivos temporales ----------------------------------------------------
*.zip
*.tmp
/tmp/

# --- Auditoria: salidas, no entradas ----------------------------------------
# Se quedan los informes escritos a mano (REPORT, RESUMEN), las reglas propias
# de Semgrep con sus casos de prueba, la configuracion de ZAP y las
# excepciones del linter de Design System, que el codigo lee al ejecutarse.
audit/arquitectura/
audit/baseline/
audit/cobertura/
audit/cobertura-salida.txt
audit/deps/
audit/lighthouse/
audit/mutacion/
audit/resumen.json
audit/visual/
audit/e2e/artefactos/
audit/e2e/informe/
audit/e2e/resultados.json
audit/correos/

# SAST: se queda la regla, no el hallazgo.
audit/sast/semgrep*.json
audit/sast/semgrep*.txt

# ZAP: se queda la configuracion, no el informe.
audit/zap/informe.*
audit/zap/salida.txt
