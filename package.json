{
  "name": "turno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:setup": "dotenv -e .env.test -- prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "cuenta": "tsx scripts/cuenta.ts",
    "correo:probar": "tsx scripts/probar-correo.ts",
    "db:demo": "tsx scripts/datos-demo.ts",
    "sesion": "tsx scripts/sesion-dev.ts",
    "simular": "tsx scripts/explorar.ts",
    "carga": "tsx scripts/carga.ts",
    "push:claves": "tsx scripts/claves-push.ts",
    "audit:cobertura": "dotenv -e .env.test -- vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text --coverage.reportsDirectory=audit/cobertura --coverage.include=src/** --coverage.exclude=src/generated/**",
    "audit:sast": "docker run --rm -v \"%cd%:/src\" -w /src semgrep/semgrep semgrep scan --config=p/typescript --config=p/react --config=p/nodejs --config=p/owasp-top-ten --config=p/secrets --config=audit/sast/reglas-turno.yml --exclude=src/generated --exclude=audit --metrics=off",
    "audit:secretos": "docker run --rm -v \"%cd%:/repo\" zricethezav/gitleaks:latest detect --source /repo --redact -v",
    "audit:arquitectura": "madge --extensions ts,tsx --ts-config tsconfig.json --exclude ^generated/ --circular src",
    "audit:mutacion": "stryker run",
    "audit:e2e": "playwright test --grep-invert \"capturas base\"",
    "rediseno:base": "playwright test capturas-base",
    "audit:e2e:ui": "playwright test --ui",
    "audit:lighthouse": "lighthouse http://localhost:3100/ --only-categories=performance,accessibility,best-practices,seo --output=json --output=html --output-path=audit/lighthouse/portada --chrome-flags=\"--headless=new --no-sandbox --disable-dev-shm-usage\" --throttling-method=provided --quiet",
    "audit": "tsx scripts/auditoria.ts",
    "audit:design": "tsx scripts/linter-design-system.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/web-push": "^3.6.4",
    "morphicons": "^1.7.0",
    "next": "16.3.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "fast-check": "^4.9.0",
    "lighthouse": "^13.4.1",
    "madge": "^8.0.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "@prisma/client": true,
    "esbuild": true,
    "unrs-resolver": true,
    "sharp": true
  }
}
