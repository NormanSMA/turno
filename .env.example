DATABASE_URL="postgresql://turno:turno@localhost:55432/turno?schema=public"
APP_URL="http://localhost:3000"
CRON_SECRET="cambiar-en-produccion"

# Correo transaccional. Sin clave, los correos se imprimen en consola.
# Para enviar de verdad hace falta un dominio propio verificado en Resend.
# RESEND_API_KEY="re_..."
# CORREO_REMITENTE="TURNO <turno@tudominio.com>"

# Alternativa: SMTP con contraseña de aplicación. No necesita dominio propio,
# porque el envío se autentica COMO el buzón real.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu@uamv.edu.ni
# SMTP_PASS="xxxx xxxx xxxx xxxx"

# Fuera de produccion, solo se escribe a la cuenta remitente. Ampliá la lista
# para probar con el equipo (separadas por coma).
# CORREO_PERMITIDOS="companero@uamv.edu.ni,asesor@uam.edu.ni"

# Web Push (ADR-14). Generalas con `npm run push:claves`.
# Sin ellas el sistema NO envia avisos push y lo dice en el log del servidor;
# el correo sigue funcionando como respaldo. La publica es la misma variable
# para el navegador y el servidor a proposito: duplicarla las desincroniza y
# el sintoma es que todo se suscribe bien y ningun envio llega.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:turno@uamv.edu.ni"
